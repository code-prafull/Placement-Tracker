{
  "name": "dsaforge",
  "version": "1.0.0",
  "private": true,
  "description": "DSAForge — MERN DSA revision app (monorepo root: backend/ + frontend/)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "npm install --prefix backend",
    "setup": "npm install --prefix backend && npm install --prefix frontend",
    "start": "npm start --prefix backend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "preview": "npm run preview --prefix frontend"
  }
}
